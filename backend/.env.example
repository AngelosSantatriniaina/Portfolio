# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_app
POSTGRES_PASSWORD=change-this-long-password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/portfolio
SPRING_DATASOURCE_USERNAME=portfolio_app
SPRING_DATASOURCE_PASSWORD=change-this-long-password

# Security: generate a base64-encoded 32+ byte secret, e.g. openssl rand -base64 48
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_SECRET_AT_LEAST_32_BYTES
JWT_COOKIE_SECURE=false
JWT_TTL_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Bootstrap admin: set a strong password only for first deployment; remove from environment afterwards.
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=CHANGE_ME_NOW

# Local uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Optional SMTP. Leave empty to persist contact messages without sending email.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
CONTACT_TO=angelossantatriniaina@gmail.com
